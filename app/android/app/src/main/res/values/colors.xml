<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 应用主题背景（与 lib/core/theme.dart 的 FoaTheme.bg 一致）。
         Bug 410（2026-09-17）：Flutter 引擎在 Android 15+ 设备
         （Build.VERSION.SDK_INT >= 35）上无条件跳过 Window.setStatusBarColor /
         setNavigationBarColor——与 app targetSdk 无关。因此运行时 SystemChrome/
         AppBar systemOverlayStyle 设的系统栏颜色在这类设备上完全失效，系统栏
         回落主题默认值。在主题 XML 里声明初始颜色，由 OS 在窗口创建时直接应用，
         不经过 Flutter 引擎，对 targetSdk 28 的应用在所有 Android 版本上均生效
         （edge-to-edge 强制仅限 targetSdk 35+）。

         Bug 457（2026-09-20）：此处 #101418 是**深色**值。窗口背景会从
         transparent 的状态栏/顶栏后面透出来，所以浅色模式下必须换成
         foa_bg_light——否则浅色顶栏底下压着一条深色状态栏。
         系统栏初始色由 styles.xml 按 night 限定符分别声明。 -->
    <color name="foa_bg">#FF101418</color>
    <!-- 浅色主题的窗口/系统栏底色（与 FoaTheme.lightSurface 一致） -->
    <color name="foa_bg_light">#FFF5F7F8</color>
</resources>
