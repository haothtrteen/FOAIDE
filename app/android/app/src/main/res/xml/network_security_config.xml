<?xml version="1.0" encoding="utf-8"?>
<!-- alpha.58 Web 实时预览：仅放行本机回环地址的明文 HTTP。

     背景：targetSdk 28 起 Android 默认禁止明文 HTTP（cleartext），
     App 内 WebView 加载 http://127.0.0.1:8090（proot 容器里的
     `flutter run -d web-server` 开发服务器）会被
     CleartextNotPermitted 拦截。这里精确放行 127.0.0.1 与
     localhost，其余域一律维持系统默认（强制 HTTPS）——
     不使用 usesCleartextTraffic="true" 的全局放行。 -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
